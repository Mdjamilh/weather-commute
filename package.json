{
	"name": "weather-commute",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Should I leave now? A commute weather planner built on Open-Meteo.",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"fixtures": "node scripts/record-fixtures.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "1.55.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "^22.20.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "8.3.4",
		"vitest": "^5.0.3"
	},
	"overrides": {
		"cookie": "0.7.2"
	}
}
